# The golden prompts are compared byte for byte, so they keep LF on every
# platform, including a Windows checkout with core.autocrlf on.
test/golden/*.txt text eol=lf

# The same for the text the release zip ships, and only for the text: git
# converts exactly the files tools/build.mjs converts, which are LICENSE and
# the extensions in its TEXT_EXTENSIONS. The build packs those with LF
# whatever the checkout holds, so the checksum does not depend on this; it
# keeps an unpacked load of a Windows checkout byte for byte the same as the
# zip. test/build.test.mjs fails when the two lists part.
#
# Anything else in the shipped folders is never converted, so an image or a
# font is committed and checked out as it is. A plain `text` on a whole
# folder calls every file in it text, and git would strip the CR from the
# CR LF that every PNG carries in its first eight bytes.
content/** -text
content/**/*.js text eol=lf
content/**/*.mjs text eol=lf
content/**/*.json text eol=lf
content/**/*.html text eol=lf
content/**/*.css text eol=lf
content/**/*.svg text eol=lf
content/**/*.txt text eol=lf
content/**/*.md text eol=lf

