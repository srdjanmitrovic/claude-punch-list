# LICENSE at any depth, as the build has it, and the files at the top.
LICENSE text eol=lf
manifest.json text eol=lf
background.js text eol=lf

# Binary wherever it is (no diff, no merge, no conversion), whatever
# core.autocrlf says and whatever git would guess from the content.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.zip binary
